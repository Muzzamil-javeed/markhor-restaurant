# Postgres (office staging / production). Prisma-compatible PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full"

ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-session-secret"

# Public site URL on staging (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://staging.example.com"

NEXT_PUBLIC_RESTAURANT_PHONE=+923322396608
NEXT_PUBLIC_WHATSAPP_NUMBER=923322396608
GST_RATE=0.15
DELIVERY_FEE=0
MIN_ORDER_DELIVERY=0

# Optional — only if you keep Vercel Blob. Softnox/local uploads write under public/.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Optional local tooling (not required on staging)
# PEXELS_API_KEY=
# UNSPLASH_ACCESS_KEY=
