{
  "name": "markhorsmokedmeat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --config prisma7.config.ts && prisma migrate deploy --config prisma7.config.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lh-desktop.mjs",
    "postinstall": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "lighthouse": "^12.8.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
